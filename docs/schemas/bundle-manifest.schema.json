{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://revit-mcp.invalid/schemas/bundle-manifest.schema.json",
  "title": "Issue Manager 版本包 manifest（schemaVersion 1）",
  "description": "外掛端（REVIT_MCP_study）的 manifest schema。內容與網站端權威檔 docs/spec/schemas/bundle-manifest.schema.json（Issue Manager repo，D-602）逐欄一致，只有 $id 與本說明不同；docs/schemas/web-authoritative/ 內是權威檔的原樣副本，tools/bundle-manifest.schema.test.mjs 與 C# 測試會比對，差異清單必須為空。更新權威檔時兩份副本一起換。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revitDoc", "exportedAt", "originOffsetMeters", "sheets", "views", "files", "options", "warnings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "revitDoc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "versionNumber"],
      "properties": {
        "title": { "type": "string", "maxLength": 300 },
        "versionNumber": { "type": "string", "maxLength": 100 }
      }
    },
    "exportedAt": { "type": "string", "maxLength": 40, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
    "originOffsetMeters": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number", "minimum": -1000000000, "maximum": 1000000000 }
    },
    "sheetSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 300 } }
    },
    "sheets": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pageNumber", "sheetNumber", "title", "uniqueId", "viewports"],
        "properties": {
          "pageNumber": { "type": "integer", "minimum": 1, "maximum": 1000 },
          "sheetNumber": { "type": "string", "minLength": 1, "maxLength": 100 },
          "title": { "type": "string", "maxLength": 500 },
          "uniqueId": { "type": "string", "minLength": 1, "maxLength": 200 },
          "viewports": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["viewUniqueId", "viewName", "viewKind", "isPrimary"],
              "properties": {
                "viewUniqueId": { "type": "string", "minLength": 1, "maxLength": 200 },
                "viewName": { "type": "string", "maxLength": 300 },
                "viewKind": { "$ref": "#/definitions/viewKind" },
                "isPrimary": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "views": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uniqueId", "name", "kind"],
        "properties": {
          "uniqueId": { "type": "string", "minLength": 1, "maxLength": 200 },
          "name": { "type": "string", "maxLength": 300 },
          "kind": { "$ref": "#/definitions/viewKind" }
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pdf": { "$ref": "#/definitions/pdfFile" },
        "glb": { "$ref": "#/definitions/glbFile" },
        "namedViews": { "$ref": "#/definitions/jsonFile" },
        "viewPositions": { "$ref": "#/definitions/jsonFile" },
        "params": { "$ref": "#/definitions/paramsFile" }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": ["designOptions"],
      "properties": { "designOptions": { "type": "boolean" } }
    },
    "warnings": { "type": "array", "maxItems": 200, "items": { "type": "string", "maxLength": 500 } }
  },
  "definitions": {
    "viewKind": { "enum": ["3d", "plan", "ceiling", "section", "elevation", "detail"] },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "pdfFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "bytes", "sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^\\\\/\\u0000-\\u001f\\u007f]+\\.[Pp][Dd][Ff]$" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 314572800 },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "glbFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "bytes", "sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^\\\\/\\u0000-\\u001f\\u007f]+\\.[Gg][Ll][Bb]$" },
        "bytes": { "type": "integer", "minimum": 20, "maximum": 524288000 },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "paramsFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "bytes", "sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^\\\\/\\u0000-\\u001f\\u007f]+\\.[Jj][Ss][Oo][Nn]$" },
        "bytes": { "type": "integer", "minimum": 2, "maximum": 8388608 },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "jsonFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "bytes", "sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^\\\\/\\u0000-\\u001f\\u007f]+\\.[Jj][Ss][Oo][Nn]$" },
        "bytes": { "type": "integer", "minimum": 2, "maximum": 4194304 },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    }
  }
}
